---
interface Props {
  currentPage?: string;
  user: any;
  area?: 'site' | 'store';
}

const { currentPage = 'dashboard', user, area = 'site' } = Astro.props;

const storeGroups = [
  {
    label: '',
    items: [{ href: '/admin/tienda', id: 'store-dashboard', label: 'Resumen' }],
  },
  {
    label: 'Catálogo',
    items: [
      { href: '/admin/tienda/productos', id: 'store-products', label: 'Productos' },
      { href: '/admin/tienda/variantes', id: 'store-variants', label: 'Variantes' },
      { href: '/admin/tienda/categorias', id: 'store-categories', label: 'Categorías' },
      { href: '/admin/tienda/inventario', id: 'store-inventory', label: 'Inventario' },
      { href: '/admin/tienda/marcas', id: 'store-brands', label: 'Marcas' },
      { href: '/admin/tienda/colecciones', id: 'store-collections', label: 'Colecciones' },
    ],
  },
  {
    label: 'Pedidos y envíos',
    items: [
      { href: '/admin/tienda/pedidos', id: 'store-orders', label: 'Pedidos' },
      { href: '/admin/tienda/envios', id: 'store-packlink', label: 'Packlink' },
      { href: '/admin/tienda/devoluciones', id: 'store-returns', label: 'Devoluciones' },
    ],
  },
  {
    label: '',
    items: [{ href: '/admin/tienda/clientes', id: 'store-customers', label: 'Clientes' }],
  },
  {
    label: 'Marketing',
    items: [
      { href: '/admin/tienda/descuentos', id: 'store-discounts', label: 'Descuentos y cupones' },
      { href: '/admin/tienda/campanas', id: 'store-campaigns', label: 'Campañas' },
      { href: '/admin/tienda/promociones', id: 'store-promos', label: 'Destacados y banners' },
    ],
  },
  {
    label: 'Contenido',
    items: [
      { href: '/admin/tienda/contenido', id: 'store-content', label: 'Inicio y páginas' },
      { href: '/admin/tienda/menus', id: 'store-menus', label: 'Menús' },
      { href: '/admin/tienda/bloques', id: 'store-blocks', label: 'Bloques' },
      { href: '/admin/tienda/seo', id: 'store-seo', label: 'SEO' },
    ],
  },
  {
    label: '',
    items: [
      { href: '/admin/tienda/formas-de-pago', id: 'store-payments', label: 'Formas de pago' },
      { href: '/admin/tienda/configuracion', id: 'store-settings', label: 'Configuración' },
    ],
  },
];
---

<aside class="sidebar">
  <div class="sidebar-header">
    <a href="/admin" class="logo">
      <img src="https://pub-395d6f9fbe0b43ef97c60de0f4282eed.r2.dev/srtanognog-logo.png" alt="Logo" />
    </a>
  </div>

  <!-- Usuario -->
  <div class="user-section">
    <div class="user-avatar">
      <span>{user?.email?.[0].toUpperCase()}</span>
    </div>
    <div class="user-details">
      <p class="user-email">{user?.email}</p>
      <span class="user-role">Administrador</span>
    </div>
  </div>

  <!-- Menú de navegación -->
  <nav class="sidebar-nav">
    {area === 'store' ? (
      <>
        <a href="/admin" class="nav-item nav-back">{'< Atrás'}</a>
        {storeGroups.map((group) => (
          <>
            {group.label && <p class="nav-label">{group.label}</p>}
            {group.items.map((item) => (
              <a href={item.href} class={`nav-item nav-sub ${currentPage === item.id ? 'active' : ''}`}>{item.label}</a>
            ))}
          </>
        ))}
      </>
    ) : (
      <>
        <a href="/admin" class={`nav-item ${currentPage === 'dashboard' ? 'active' : ''}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          <span>Dashboard</span>
        </a>

        <a href="/admin/projects" class={`nav-item ${currentPage === 'projects' ? 'active' : ''}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
          </svg>
          <span>Proyectos</span>
        </a>

        <a href="/admin/media" class={`nav-item ${currentPage === 'media' ? 'active' : ''}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          <span>Medios</span>
        </a>

        <a href="/admin/pages" class={`nav-item ${currentPage === 'pages' ? 'active' : ''}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          <span>Páginas</span>
        </a>

        <a href="/admin/redirections" class={`nav-item ${currentPage === 'redirections' ? 'active' : ''}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 3h4v4"></path>
            <path d="M3 21l18-18"></path>
            <path d="M7 3H3v4"></path>
            <path d="M21 17v4h-4"></path>
          </svg>
          <span>Redirecciones</span>
        </a>

        <a href="/admin/links" class={`nav-item ${currentPage === 'links' ? 'active' : ''}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
          <span>Enlaces</span>
        </a>

        <a href="/admin/tienda" class="nav-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
            <path d="M3 6h18"></path>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span>Tienda</span>
        </a>

        <a href="/admin/settings" class={`nav-item ${currentPage === 'settings' ? 'active' : ''}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
          <span>Configuración</span>
        </a>
      </>
    )}

    <button id="logoutBtn" class="nav-item logout-item">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
        <polyline points="16 17 21 12 16 7"></polyline>
        <line x1="21" y1="12" x2="9" y2="12"></line>
      </svg>
      <span>Cerrar sesión</span>
    </button>
  </nav>
</aside>

<script>
  import { auth } from '../../lib/firebase-client';
  import { signOut } from 'firebase/auth';

  const logoutBtn = document.getElementById('logoutBtn');
  logoutBtn?.addEventListener('click', async () => {
    try {
      await signOut(auth);
      document.cookie = 'session=; path=/; max-age=0';
      window.location.href = '/admin/login';
    } catch (error) {
      console.error('Error al cerrar sesión:', error);
    }
  });
</script>

<style>
  .sidebar {
    background: #1e293b;
    color: #fff;
    display: flex;
    flex-direction: column;
    position: fixed;
    width: 280px;
    height: 100vh;
    overflow-y: auto;
    z-index: 1000;
    top: 0;
    left: 0;
    grid-column: 1;
  }

  .sidebar-header {
    padding: 2rem 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .sidebar-header .logo {
    display: block;
  }

  .sidebar-header .logo img {
    width: 180px;
    height: auto;
    display: block;
  }

  .user-section {
    padding: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .user-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 600;
    flex-shrink: 0;
  }

  .user-details {
    flex: 1;
    min-width: 0;
  }

  .user-email {
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .user-role {
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .sidebar-nav {
    flex: 1;
    padding: 1rem 0;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1.5rem;
    color: #94a3b8;
    text-decoration: none;
    transition: all 0.2s;
    border: none;
    background: none;
    width: 100%;
    cursor: pointer;
    font-size: 0.9375rem;
    font-family: inherit;
  }

  .nav-item:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
  }

  .nav-item.active {
    background: rgba(102, 126, 234, 0.15);
    color: #fff;
    border-right: 3px solid #667eea;
  }

  .nav-item svg {
    flex-shrink: 0;
  }

  .nav-back {
    color: #fff;
    font-weight: 600;
  }

  .nav-label {
    margin: 0.85rem 0 0.1rem;
    padding: 0.35rem 1.5rem 0.15rem;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #64748b;
  }

  .nav-sub {
    padding-left: 1.75rem;
  }

  .logout-item {
    margin-top: auto;
    color: #f87171;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .logout-item:hover {
    background: rgba(248, 113, 113, 0.1);
    color: #fca5a5;
  }
</style>
