---
import { getPublicEnv } from '../lib/public-env';

const publicEnv = getPublicEnv();
const publicEnvJson = JSON.stringify(publicEnv).replace(/</g, '\\u003c');
---

<script id="public-env-data" type="application/json" set:html={publicEnvJson}></script>
<script is:inline>
  (function () {
    var element = document.getElementById('public-env-data');
    if (!element || !element.textContent) return;
    try {
      var parsed = JSON.parse(element.textContent);
      window.__PUBLIC_ENV__ = Object.assign({}, window.__PUBLIC_ENV__ || {}, parsed);
    } catch (error) {
      console.error('Failed to parse public environment config', error);
    }
  })();
</script>
